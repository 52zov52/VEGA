# --- runtime ---
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
TZ_SEED=42
DATASET_VERSION=v3
PROCESSING_VERSION=v1

# --- data providers (пустые значения = demo/fallback режим) ---
SENTINEL_API_URL=
SENTINEL_API_KEY=
LANDSAT_API_URL=
LANDSAT_API_KEY=
MODIS_API_URL=
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --- infra ---
DATABASE_URL=postgresql+psycopg://vega:vega@db:5432/vega
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=86400

# --- ML ensemble (по умолчанию из отчёта: веса подбираются train.py) ---
ENSEMBLE_W_GBM=0.55
ENSEMBLE_W_TEMPORAL=0.30
ENSEMBLE_W_SEASONAL=0.15
ANOMALY_W_NDVI=0.35
ANOMALY_W_EVI=0.15
ANOMALY_W_NDWI=0.15
ANOMALY_W_WEATHER=0.15
ANOMALY_W_SOIL=0.10
ANOMALY_W_TREND=0.10

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
